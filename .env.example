# Server only. Use a dedicated least-privilege database role in production.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:56322/postgres
# Server only. Supabase CA in PEM format for verified TLS; leave empty for Docker.
DATABASE_SSL_CA=
# Public Supabase project settings; never use a service role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3100
GOOGLE_AUTH_ENABLED=false
# Labels the shared cloud test environment without enabling local test access.
APP_ENVIRONMENT=local

# Only for the isolated Docker test database. Never enable in a deployment.
LOCAL_TEST_ACCESS=false

# Server only: private Supabase Storage; never prefix this key with NEXT_PUBLIC.
SUPABASE_SECRET_KEY=
