    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
