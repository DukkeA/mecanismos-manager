{
  "name": "mecanismos-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "prisma generate && next build",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:seed:local": "node scripts/seed-workshop.mjs && node scripts/seed-details.mjs && node scripts/seed-contact-details.mjs",
    "db:seed:details": "node scripts/seed-details.mjs",
    "db:verify:fixtures": "node scripts/verify-fixtures.mjs",
    "db:storage:local": "node scripts/setup-local-storage.mjs",
    "db:seed:commerce": "node --conditions=react-server --import tsx scripts/local-job.ts commerce",
    "db:seed:attendance": "node --conditions=react-server --import tsx scripts/local-job.ts attendance",
    "db:seed:benefits": "node --conditions=react-server --import tsx scripts/local-job.ts benefits",
    "db:seed:payroll": "node --conditions=react-server --import tsx scripts/local-job.ts payroll",
    "db:seed:team": "node --conditions=react-server --import tsx scripts/local-job.ts team",
    "db:seed:control": "node --conditions=react-server --import tsx scripts/local-job.ts control",
    "db:seed:supports": "node --conditions=react-server --import tsx scripts/local-job.ts supports",
    "db:migrate:photos:local": "node --conditions=react-server --import tsx scripts/local-job.ts photos",
    "db:backup:local": "node --import tsx scripts/backup-local.ts",
    "test:access": "node scripts/test-local-access.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@zxing/browser": "^0.2.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
