    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "7.10.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
